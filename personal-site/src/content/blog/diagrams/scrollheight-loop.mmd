flowchart TB
    subgraph BAD ["BAD: overflow visible"]
        A1["page content height<br/>= 1200px"] --> B1["measure parent.scrollHeight<br/>= 1200"]
        B1 --> C1["count = ceil(1200/600)<br/>= 2"]
        C1 --> D1["render 2 blobs<br/>last one extends past<br/>content edge to 1400"]
        D1 --> E1["scrollHeight grows<br/>to 1400"]
        E1 --> F1["ResizeObserver fires"]
        F1 --> B1
    end

    subgraph GOOD ["GOOD: overflow hidden on blob layer"]
        A2["page content height<br/>= 1200px"] --> B2["measure parent.scrollHeight<br/>= 1200"]
        B2 --> C2["count = ceil(1200/600)<br/>= 2"]
        C2 --> D2["render 2 blobs<br/>inside overflow:hidden<br/>container"]
        D2 --> E2["scrollHeight stays at<br/>1200 (overflow clipped)"]
        E2 --> F2["ResizeObserver does<br/>not fire — stable"]
    end

    style A1 fill:#1f2251,stroke:#fd5d93,color:#fff
    style B1 fill:#1f2251,stroke:#fd5d93,color:#fff
